# Environment Configuration Template
# Copy .env.example to .env and fill in actual values

# ===== SERVER CONFIGURATION =====
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# ===== FRONTEND (VITE) =====
# This URL is used in production to point frontend to backend
VITE_API_URL=http://localhost:3000

# ===== CORS =====
# Set to your frontend URL (e.g., https://pause-protect.vercel.app)
FRONTEND_URL=http://localhost:5173

# ===== GOOGLE APIS =====
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_FACTCHECK_API_KEY=your-google-factcheck-api-key

# ===== GROQ AI =====
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_LINK_CHECK_MODEL=openai/gpt-oss-120b

# ===== SESSION & AUTH =====
SESSION_SECRET=supersecret-change-in-production

# ===== FIREBASE =====
# Service account JSON (entire object as string)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"pause-prove-protect-f641d",...}'

# Or use individual Firebase config for front-end SDKs:
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# ===== DATABASE =====
# If using PostgreSQL via Neon or similar
DATABASE_URL=postgresql://user:password@host:5432/database_name
