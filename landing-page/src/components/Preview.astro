---
<section id="preview" class="preview-section">
  <div class="container preview-shell">
    <div class="preview-left">
      <p class="eyebrow">Your preview</p>
      <h2>We create a template for it.</h2>
      <p class="muted">Drop in images, copy, or embeds to show how Prova surfaces context and protects your feed.</p>
      <div class="preview-card">
        <div class="preview-media">Preview area (drop images or embeds)</div>
      </div>
      <div class="preview-cta">
        <button class="waitlist-submit">Start customizing</button>
      </div>
    </div>
    <div class="preview-right">
      <h3>Inside the app</h3>
      <div class="preview-grid">
        <div class="preview-item">Pause prompt</div>
        <div class="preview-item">Bias score</div>
        <div class="preview-item">Source check</div>
        <div class="preview-item">Share safely</div>
      </div>
    </div>
  </div>
</section>
