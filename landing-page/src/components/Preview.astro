---
---
<section id="preview" class="preview-section">
  <div class="container preview-shell">
    <div class="preview-left">
      <p class="eyebrow">Prototype preview</p>
      <h2>Your feed, verified in real time.</h2>
      <p class="muted">Right where people scroll, Prova adds signal tags, verification prompts, and AI clarity so users can make smarter sharing choices.</p>
      <div class="preview-card">
        <div class="preview-media">
          <div class="preview-phone">
            <div class="preview-phone-header">
              <span>Prova feed</span>
              <span>Live signal view</span>
            </div>
            <div class="preview-feed">
              <div class="preview-feed-item verified">
                <strong>Verified</strong>
                <p>Trusted source</p>
              </div>
              <div class="preview-feed-item flagged">
                <strong>Misleading</strong>
                <p>Check context</p>
              </div>
              <div class="preview-feed-item blocked">
                <strong>False</strong>
                <p>Do not share</p>
              </div>
              <div class="preview-feed-item prompt">
                <strong>Need more context?</strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="preview-right">
      <h3>What the experience highlights</h3>
      <div class="preview-enable">
        <h4>Enable these trust features</h4>
        <div class="enable-grid">
          <div class="enable-item">
            <span>Real-time verification</span>
            <span class="toggle on">On</span>
          </div>
          <div class="enable-item">
            <span>Community flags</span>
            <span class="toggle on">On</span>
          </div>
          <div class="enable-item">
            <span>Bias & context prompts</span>
            <span class="toggle off">Off</span>
          </div>
        </div>
      </div>
      <div class="preview-grid">
        <div class="preview-item">Verified</div>
        <div class="preview-item">Misleading</div>
        <div class="preview-item">False</div>
        <div class="preview-item">Quick verification prompts</div>
        <div class="preview-item">AI content detection</div>
        <div class="preview-item">Bias & source insight</div>
      </div>
    </div>
  </div>
</section>
