---
import background from "../assets/background.svg";
---
<section id="hero" class="hero" style={`--hero-image: url(${background.src})`}>
  <div class="hero-content">
    <p class="eyebrow">For Gen Z, by Gen Z</p>
    <h1>PROVA</h1>
    <h2>Pause. Prove. Protect.</h2>
    <p class="hero-copy">Stop misinformation in its tracks with the first verification system that works in the 3 seconds before you share.</p>
    <div class="hero-buttons">
      <a class="primary-button" href="/waitlist">Join the waitlist</a>
      <a class="secondary-button" href="#preview">See the preview</a>
    </div>
  </div>
</section>
