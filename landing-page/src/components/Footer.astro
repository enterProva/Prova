---
const year = new Date().getFullYear();
---

<footer id="footer" class="footer">
  <div class="container footer-shell">
    <div class="footer-intro">
      <div class="footer-brand">
        <img src="/mobile-app-logo.png" alt="Logo" class="footer-logo" />
        <div>
          <h2>Prova</h2>
          <p>Clarity before the share.</p>
        </div>
      </div>
      <p class="footer-copy">Built for young people who want context, credibility, and calm before they hit send.</p>
    </div>

    <div class="footer-contact-card">
      <p class="contact-label">Say Hello</p>
      <a href="mailto:heyy.prova@gmail.com" class="contact-link">heyy.prova@gmail.com</a>
      <p class="contact-note">For early access, partnerships, or just a good idea.</p>
    </div>
    
    <div class="footer-meta">
      <p class="footer-copyright">© {year} Prova</p>
    </div>
  </div>
</footer>