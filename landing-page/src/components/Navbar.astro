---
---

<nav class="navbar">
    <div class="navbar-inner">
        <a href="/" class="logo-link mobile-logo">
            <img src="/mobile app-logo.png" alt="PROVA logo">
            <span>PROVA</span>
        </a>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
            <span class="visually-hidden">Open navigation menu</span>
            <span class="nav-toggle-icon" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
        </button>

        <ul id="nav-links" class="nav-links">
            <li><a href="/#preview">Sneak Peek</a></li>
            <li><a href="/#build">Launch</a></li>
            <li class="nav-logo">
                <a href="/" class="logo-link">
                    <img src="/mobile app-logo.png" alt="PROVA logo">
                    <span>PROVA</span>
                </a>
            </li>
            <li><a href="/#how">How It Works</a></li>
            <li><a href="/#footer">Ping</a></li>
            <li><a href="/waitlist" class="cta-link">Join Waitlist</a></li>
        </ul>

        <div class="nav-backdrop" aria-hidden="true"></div>
    </div>
</nav>

<script is:inline>
  const menuButton = document.querySelector('.nav-toggle');
  const navLinks = document.getElementById('nav-links');

  if (menuButton && navLinks) {
    const navBackdrop = document.querySelector('.nav-backdrop');

    const closeMenu = () => {
      navLinks.classList.remove('open');
      menuButton.setAttribute('aria-expanded', 'false');
      navBackdrop?.classList.remove('open');
    };

    menuButton.addEventListener('click', () => {
      const expanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!expanded));
      navLinks.classList.toggle('open', !expanded);
      navBackdrop?.classList.toggle('open', !expanded);
    });

    document.addEventListener('click', (event) => {
      if (!navLinks.contains(event.target) && !menuButton.contains(event.target)) {
        closeMenu();
      }
    });

    navBackdrop?.addEventListener('click', closeMenu);
  }
</script>